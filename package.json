{
  "name": "ordenando-mis-actividades",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicación de organización de actividades para Android y Windows",
  "main": "electron-main.cjs",
  "scripts": {
    "build:windows": "electron-builder --win nsis",
    "build:android": "cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ar.ordenandomisactividades.app",
    "productName": "Ordenando mis actividades",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "electron-main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
